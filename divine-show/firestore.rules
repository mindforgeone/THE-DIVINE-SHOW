rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == '5CMckLFqiCPoPCBQLz1YqBkgVXs1';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /divine_data/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /friendRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.participants);
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.to in request.resource.data.participants
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin() || (signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants);
    }

    match /friendships/{friendshipId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.members);
      allow create: if isAdmin() || (signedIn()
        && request.auth.uid in request.resource.data.members
        && getAfter(/databases/$(database)/documents/friendRequests/$(friendshipId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/friendRequests/$(friendshipId)).data.participants == request.resource.data.members);
      allow update, delete: if isAdmin() || (signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members);
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.members);
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update, delete: if isAdmin() || (signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members);

      match /messages/{messageId} {
        function canReadConversation() {
          return signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        }
        allow read: if isAdmin() || canReadConversation();
        allow create: if canReadConversation() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin() || (canReadConversation() && resource.data.senderId == request.auth.uid);
      }
    }

    match /challenges/{challengeId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.participants);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.participants;
      allow update, delete: if isAdmin() || (signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants);
    }
  }
}
