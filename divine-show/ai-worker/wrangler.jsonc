{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "day-one-analyst",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "SYNC_DB",
      "database_name": "day-one-sync",
      "database_id": "8e187fcf-f8c8-4484-b0c6-b7a9ae5a8e6f"
    }
  ],
  "vars": {
    "ADMIN_UID": "5CMckLFqiCPoPCBQLz1YqBkgVXs1",
    "FIREBASE_API_KEY": "AIzaSyDHVp0mEj1rvLdFXXnI3_0J_PVyt06_DX0",
    "PRIMARY_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "FALLBACK_MODEL": "@cf/openai/gpt-oss-120b",
    "ALLOWED_ORIGINS": "https://mindforgeone.github.io,http://localhost:5173,http://localhost:5180"
  }
}
